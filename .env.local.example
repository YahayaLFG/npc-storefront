NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# SECRET - Supabase -> Project Settings -> API -> service_role key.
# Never prefix with NEXT_PUBLIC_. Used only by the Paystack webhook.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# SECRET - Paystack -> Settings -> API Keys & Webhooks -> Secret Key.
PAYSTACK_SECRET_KEY=your-paystack-secret-key

# Your deployed site URL, no trailing slash. Paystack redirects here after payment.
NEXT_PUBLIC_APP_URL=https://your-deployed-site.vercel.app

# Powers the admin "Quick Import" screenshot reading feature.
ANTHROPIC_API_KEY=your-anthropic-api-key

# Optional - email notifications (dashboard notifications work without it)
RESEND_API_KEY=your-resend-api-key
NOTIFICATIONS_FROM_EMAIL=NPC <notifications@yourdomain.com>
